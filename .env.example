# Copy this file to `.env.local` and fill in the values. `.env.local` is ignored
# by git, so your values never end up on GitHub.
#
# IMPORTANT: Anything starting with VITE_ is bundled into the website and is
# PUBLIC. Only public keys go here. Secret keys (Supabase service_role key,
# payment secret key, Mailgun API key) must ONLY ever live on a server.

# Shop settings
VITE_CURRENCY=NGN
VITE_STORE_NAME=Confam NG
# Public contact email shown on the Privacy policy page, e.g. hello@yourdomain.com
VITE_SUPPORT_EMAIL=

# Supabase — Dashboard → Project Settings → API (or "Connect")
#   URL:      the "Project URL", e.g. https://abcdefghijkl.supabase.co
#   Anon key: the "anon public" key (or the newer "publishable" key, sb_publishable_…)
# Leave both empty to run the shop with sample data and demo accounts.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Payment gateway — public key only (added in the payment step)
VITE_PAYMENT_PUBLIC_KEY=
