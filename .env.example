# Copy this file to `.env.local` and fill in values when we reach Phase 2.
# NEVER commit real values. `.env.local` is ignored by git.
#
# IMPORTANT: Anything starting with VITE_ is bundled into the browser and is
# PUBLIC. Only put publishable/public keys here. Secret keys (payment secret
# key, Mailgun API key, database service-role key) must live on a server
# (e.g. Supabase Edge Functions / serverless functions), never in this app.

# Shop settings (safe to be public)
VITE_CURRENCY=NGN
VITE_STORE_NAME=Confam NG

# Phase 2 — public values only (leave empty for now)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_PAYMENT_PUBLIC_KEY=
